---
import type { Locale } from '../i18n/config';
import { getLocalePath } from '../i18n/config';
import footerLogo from '../assets/brand/koalastuff-logo-128.png';
import { Picture } from 'astro:assets';

export interface Props {
  locale: Locale;
  translations: Record<string, string>;
}

const { locale, translations: tr } = Astro.props;

const privacyHref = locale === 'de'
  ? '/de/datenschutz/'
  : '/privacy/';
const imprintHref = locale === 'de'
  ? '/de/impressum/'
  : '/imprint/';
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="site-footer__grid">
      <!-- Brand col -->
      <div class="site-footer__brand-col">
        <div class="site-footer__brand">
          <Picture src={footerLogo} formats={['avif', 'webp']} densities={[1, 2]} alt="" width={24} height={24} />
          <span>KoalaStuff</span>
        </div>
        <p class="site-footer__tagline">
          Small open-source tools for real annoyances. Browser extensions, web tools, desktop utilities and experiments.
        </p>
        <p class="site-footer__meta">
          {tr['footer.madeBy'] ?? 'Made by'} <a href="https://github.com/Shik3i" rel="noopener noreferrer">Timo</a>
          &nbsp;·&nbsp;
          {tr['footer.rights'] ?? 'Open source under the MIT License.'}
        </p>
      </div>

      <!-- Projects col -->
      <div class="site-footer__col">
        <h3>{tr['footer.projects'] ?? 'Projects'}</h3>
        <ul>
          <li><a href="https://sync.koalastuff.net" rel="noopener noreferrer">KoalaSync</a></li>
          <li><a href="https://github.com/Shik3i/KoalaPull" rel="noopener noreferrer">KoalaPull</a></li>
          <li><a href="https://github.com/Shik3i/KoalaClicker" rel="noopener noreferrer">KoalaClicker</a></li>
          <li><a href="https://github.com/Shik3i/KoalaSound" rel="noopener noreferrer">KoalaSound</a></li>
        </ul>
      </div>

      <!-- Links col -->
      <div class="site-footer__col">
        <h3>Links</h3>
        <ul>
          <li><a href="https://github.com/Shik3i" rel="noopener noreferrer">{tr['footer.github'] ?? 'GitHub'}</a></li>
          <li><a href="https://dev.to/hungrykoala" rel="noopener noreferrer">{tr['footer.devto'] ?? 'dev.to'}</a></li>
          <li><a href={privacyHref}>{tr['footer.privacy'] ?? 'Privacy'}</a></li>
          <li><a href={imprintHref}>{tr['footer.imprint'] ?? 'Imprint'}</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {new Date().getFullYear()} KoalaStuff &nbsp;·&nbsp; No cookies &nbsp;·&nbsp; No tracking &nbsp;·&nbsp; No analytics</p>
      <p>
        <a href={privacyHref}>{tr['footer.privacy'] ?? 'Privacy'}</a>
        &nbsp;·&nbsp;
        <a href={imprintHref}>{tr['footer.imprint'] ?? 'Imprint'}</a>
      </p>
    </div>
  </div>
</footer>
