---
import type { Locale } from '../i18n/config';
import { locales, localeNames, getLocalePath, localeLangCodes } from '../i18n/config';
import type { TranslationDict } from '../i18n/utils';
import headerLogo from '../assets/brand/koalastuff-logo-128.png';
import { Picture } from 'astro:assets';

export interface Props {
  locale: Locale;
  translations: Record<string, string>;
  currentPath?: string;
}

const { locale, translations: tr, currentPath = '/' } = Astro.props;

const basePath = currentPath.replace(/^\/(de|fr|es|it|nl|pl|pt|tr|ja|ko|zh|uk)(\/|$)/, '/').replace(/\/$/, '') || '/';
---

<header class="site-header" role="banner">
  <div class="container">
     <div class="site-header__inner">
      <!-- Logo -->
      <a href={getLocalePath(locale)} class="site-header__logo" aria-label="KoalaStuff — Home">
        <Picture src={headerLogo} formats={['avif', 'webp']} densities={[1, 2]} alt="" width={28} height={28} />
        <span>KoalaStuff</span>
      </a>

      <!-- Desktop nav -->
      <nav class="site-header__nav" aria-label="Main navigation">
        <a href={getLocalePath(locale, 'projects')} aria-current={currentPath.includes('/projects') ? 'page' : undefined} data-astro-prefetch="hover">{tr['nav.projects'] ?? 'Projects'}</a>
        <a href={getLocalePath(locale, 'blog')} aria-current={currentPath.includes('/blog') ? 'page' : undefined} data-astro-prefetch="hover">{tr['nav.blog'] ?? 'Blog'}</a>
        <a href={`${getLocalePath(locale)}#about`}>{tr['nav.about'] ?? 'About'}</a>
        <a href={`${getLocalePath(locale)}#faq`}>{tr['nav.faq'] ?? 'FAQ'}</a>
      </nav>

      <div class="site-header__spacer"></div>

      <!-- Actions -->
      <div class="site-header__actions">
        <!-- GitHub -->
        <a
          href="https://github.com/Shik3i"
          class="icon-link desktop-only"
          rel="noopener noreferrer"
          aria-label="GitHub"
          title="GitHub"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>

        <!-- dev.to -->
        <a
          href="https://dev.to/hungrykoala"
          class="icon-link desktop-only"
          rel="noopener noreferrer"
          aria-label="dev.to"
          title="dev.to"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.29zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"/>
          </svg>
        </a>

        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          class="theme-toggle"
          aria-label={tr['nav.switchToLight'] ?? 'Switch to light theme'}
          aria-pressed="false"
          type="button"
        >
          <!-- Sun (shown in dark mode to switch to light) -->
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/>
            <line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/>
            <line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <!-- Moon (shown in light mode to switch to dark) -->
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Language switcher -->
        <nav class="lang-switcher" aria-label={tr['nav.switchLanguage'] ?? 'Switch language'}>
          <button
             id="lang-switcher-btn"
            class="lang-switcher__btn"
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="lang-switcher-dropdown"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px;">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
            <span>{locale.toUpperCase()}</span>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true" style="margin-left: 2px;">
              <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div
            id="lang-switcher-dropdown"
            class="lang-switcher__dropdown"
            role="listbox"
            aria-label={tr['nav.switchLanguage'] ?? 'Switch language'}
          >
            {locales.map((l) => (
              <a
                href={getLocalePath(l, basePath)}
                hreflang={localeLangCodes[l]}
                aria-current={l === locale ? 'true' : undefined}
                role="option"
                aria-selected={l === locale}
              >
                {localeNames[l]}
              </a>
            ))}
          </div>
        </nav>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="mobile-menu-btn"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={tr['nav.openMenu'] ?? 'Open menu'}
          type="button"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile nav -->
  <div id="mobile-nav" class="mobile-nav" role="navigation" aria-label="Mobile navigation">
    <div class="container">
      <a href={getLocalePath(locale, 'projects')} aria-current={currentPath.includes('/projects') ? 'page' : undefined} data-astro-prefetch="hover">{tr['nav.projects'] ?? 'Projects'}</a>
      <a href={getLocalePath(locale, 'blog')} aria-current={currentPath.includes('/blog') ? 'page' : undefined} data-astro-prefetch="hover">{tr['nav.blog'] ?? 'Blog'}</a>
      <a href={`${getLocalePath(locale)}#about`}>{tr['nav.about'] ?? 'About'}</a>
      <a href={`${getLocalePath(locale)}#faq`}>{tr['nav.faq'] ?? 'FAQ'}</a>
      <div class="mobile-nav__actions">
        <a href="https://github.com/Shik3i" rel="noopener noreferrer" class="link-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
        <a href="https://dev.to/hungrykoala" rel="noopener noreferrer" class="link-icon">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="18" height="18">
            <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.29zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"/>
          </svg>
          dev.to
        </a>
      </div>
    </div>
  </div>
</header>
