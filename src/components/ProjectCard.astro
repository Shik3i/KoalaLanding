---
import type { Locale } from '../i18n/config';
import type { Project } from '../data/projects';
import { getProjectDescription, getProjectSlug } from '../data/projects';
import { getLocalePath } from '../i18n/config';
import { Picture } from 'astro:assets';

export interface Props {
  project: Project;
  locale: Locale;
  translations: Record<string, string>;
}

const { project, locale, translations: tr } = Astro.props;
const statusClass = `badge--${project.status}`;
const statusLabel = tr[`status.${project.status}`] ?? project.status;
const detailHref = getLocalePath(locale, `projects/${getProjectSlug(project)}`);

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpeg,jpg,png,gif,webp,svg}');
const assetPath = project.assets.icon ? `/src${project.assets.icon}` : null;
const isSvg = project.assets.icon?.endsWith('.svg');
const imageImport = assetPath ? images[assetPath] : null;
const imageSrc = imageImport ? (await imageImport()).default : null;
---

<article
  class="project-card reveal-on-scroll"
  style={`--project-accent: ${project.accentColor ?? 'var(--c-accent)'}`}
  data-tags={project.tags.join(',')}
>
  <div class="project-card__header">
    <div>
      {isSvg && project.assets.icon ? (
        <img
          src={project.assets.icon}
          alt={`${project.name} ${tr['featured.icon'] ?? 'icon'}`}
          title={`${project.name} ${tr['featured.icon'] ?? 'icon'}`}
          class="project-card__icon"
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
      ) : imageSrc ? (
        <Picture
          src={imageSrc}
          formats={['avif', 'webp']}
          densities={[1, 2]}
          alt={`${project.name} ${tr['featured.icon'] ?? 'icon'}`}
          class="project-card__icon"
          width={40}
          height={40}
        />
      ) : (
        <div
          class="project-card__icon"
          style={`background: hsl(from ${project.accentColor ?? 'var(--c-accent)'} h s l / 0.15); display:flex; align-items:center; justify-content:center; color: ${project.accentColor ?? 'var(--c-accent)'}`}
          aria-hidden="true"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
        </div>
      )}
    </div>
    <span class={`badge ${statusClass}`}>{statusLabel}</span>
  </div>

  <h4 class="project-card__title">
    <a href={detailHref}>{project.name}</a>
  </h4>

  <p class="project-card__desc">
    {getProjectDescription(project, locale)}
  </p>

  {project.backstory && (
    <details class="project-card__backstory">
      <summary>{tr['project.story']}</summary>
      <div class="project-card__backstory-content">
        <p>{project.backstory[locale] ?? project.backstory.en}</p>
      </div>
    </details>
  )}

  <div class="project-card__footer">
    <div class="tags">
      {project.tags.slice(0, 3).map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <div class="project-card__links">
      <a href={detailHref} class="link-icon" title={`${project.name} ${tr['project.details'] ?? 'details'}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3h7v7"></path>
          <path d="M10 14 21 3"></path>
          <path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"></path>
        </svg>
        {tr['project.details'] ?? 'Details'}
      </a>
      {project.links.website && project.status !== 'wip' && (
        <a href={project.links.website} class="link-icon" title="Website" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          Website
        </a>
      )}
      {project.links.github && (
        <a href={project.links.github} class="link-icon" title="GitHub" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      )}
      {project.links.chrome && project.status !== 'wip' && (
        <a href={project.links.chrome} class="link-icon" data-link-platform="chrome" title="Chrome Store" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z"/>
          </svg>
          Chrome
        </a>
      )}
      {project.links.firefox && project.status !== 'wip' && (
        <a href={project.links.firefox} class="link-icon" data-link-platform="firefox" title="Firefox Add-ons" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8.824 7.287c.008 0 .004 0 0 0zm-2.8-1.4c.006 0 .003 0 0 0zm16.754 2.161c-.505-1.215-1.53-2.528-2.333-2.943.654 1.283 1.033 2.57 1.177 3.53l.002.02c-1.314-3.278-3.544-4.6-5.366-7.477-.091-.147-.184-.292-.273-.446a3.545 3.545 0 01-.13-.24 2.118 2.118 0 01-.172-.46.03.03 0 00-.027-.03.038.038 0 00-.021 0l-.006.001a.037.037 0 00-.01.005L15.624 0c-2.585 1.515-3.657 4.168-3.932 5.856a6.197 6.197 0 00-2.305.587.297.297 0 00-.147.37c.057.162.24.24.396.17a5.622 5.622 0 012.008-.523l.067-.005a5.847 5.847 0 011.957.222l.095.03a5.816 5.816 0 01.616.228c.08.036.16.073.238.112l.107.055a5.835 5.835 0 01.368.211 5.953 5.953 0 012.034 2.104c-.62-.437-1.733-.868-2.803-.681 4.183 2.09 3.06 9.292-2.737 9.02a5.164 5.164 0 01-1.513-.292 4.42 4.42 0 01-.538-.232c-1.42-.735-2.593-2.121-2.74-3.806 0 0 .537-2 3.845-2 .357 0 1.38-.998 1.398-1.287-.005-.095-2.029-.9-2.817-1.677-.422-.416-.622-.616-.8-.767a3.47 3.47 0 00-.301-.227 5.388 5.388 0 01-.032-2.842c-1.195.544-2.124 1.403-2.8 2.163h-.006c-.46-.584-.428-2.51-.402-2.913-.006-.025-.343.176-.389.206-.406.29-.787.616-1.136.974-.397.403-.76.839-1.085 1.303a9.816 9.816 0 00-1.562 3.52c-.003.013-.11.487-.19 1.073-.013.09-.026.181-.037.272a7.8 7.8 0 00-.069.667l-.002.034-.023.387-.001.06C.386 18.795 5.593 24 12.016 24c5.752 0 10.527-4.176 11.463-9.661.02-.149.035-.298.052-.448.232-1.994-.025-4.09-.753-5.844z"/>
          </svg>
          Firefox
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card__backstory {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    border-top: 1px solid var(--c-border-subtle);
    padding-top: var(--space-3);
  }
  
  .project-card__backstory summary {
    cursor: pointer;
    font-weight: 500;
    color: var(--c-text);
    user-select: none;
    transition: color var(--dur-fast);
  }
  
  .project-card__backstory summary:hover {
    color: var(--c-accent);
  }

  .project-card__backstory-content {
    margin-top: var(--space-3);
    line-height: 1.6;
    background: var(--c-surface-alt);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--c-border-subtle);
  }
</style>
