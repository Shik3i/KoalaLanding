---
import type { Locale } from '../i18n/config';
import type { Project } from '../data/projects';
import { getProjectDescription } from '../data/projects';
import { Picture } from 'astro:assets';

export interface Props {
  project: Project;
  locale: Locale;
  translations: Record<string, string>;
}

const { project, locale, translations: tr } = Astro.props;
const statusClass = `badge--${project.status}`;
const statusLabel = tr[`status.${project.status}`] ?? project.status;
const primaryLink = project.links.website ?? project.links.github ?? '#';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpeg,jpg,png,gif,webp,svg}');
const assetPath = project.assets.icon ? `/src${project.assets.icon}` : null;
const isSvg = project.assets.icon?.endsWith('.svg');
const imageImport = assetPath ? images[assetPath] : null;
const imageSrc = imageImport ? (await imageImport()).default : null;
---

<article
  class="project-card"
  style={`--project-accent: ${project.accentColor ?? 'var(--c-accent)'}`}
>
  <div class="project-card__header">
    <div>
      {isSvg && project.assets.icon ? (
        <img
          src={project.assets.icon}
          alt=""
          class="project-card__icon"
          width="40"
          height="40"
          loading="lazy"
          decoding="async"
        />
      ) : imageSrc ? (
        <Picture
          src={imageSrc}
          formats={['avif', 'webp']}
          densities={[1, 2]}
          alt=""
          class="project-card__icon"
          width={40}
          height={40}
        />
      ) : (
        <div
          class="project-card__icon"
          style={`background: hsl(from ${project.accentColor ?? 'var(--c-accent)'} h s l / 0.15); display:flex; align-items:center; justify-content:center; color: ${project.accentColor ?? 'var(--c-accent)'}`}
          aria-hidden="true"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
        </div>
      )}
    </div>
    <span class={`badge ${statusClass}`}>{statusLabel}</span>
  </div>

  <h4 class="project-card__title">{project.name}</h4>

  <p class="project-card__desc">
    {getProjectDescription(project, locale)}
  </p>

  <div class="project-card__footer">
    <div class="tags">
      {project.tags.slice(0, 3).map((tag) => (
        <span class="tag">{tag}</span>
      ))}
    </div>

    <div class="project-card__links">
      {project.links.website && project.status !== 'wip' && (
        <a href={project.links.website} class="link-icon" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          Website
        </a>
      )}
      {project.links.github && (
        <a href={project.links.github} class="link-icon" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          GitHub
        </a>
      )}
      {project.links.chrome && project.status !== 'wip' && (
        <a href={project.links.chrome} class="link-icon" rel="noopener noreferrer">
          Chrome
        </a>
      )}
      {project.links.firefox && project.status !== 'wip' && (
        <a href={project.links.firefox} class="link-icon" rel="noopener noreferrer">
          Firefox
        </a>
      )}
    </div>
  </div>
</article>
