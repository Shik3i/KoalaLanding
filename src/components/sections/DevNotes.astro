---
import { getLocalePath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';

export interface Props {
  locale: Locale;
  translations: Record<string, string>;
}
const { locale, translations: tr } = Astro.props;
---

<section class="section section--tight" aria-labelledby="devnotes-title">
  <div class="container" style="max-width: 600px;">
    <div class="devnotes-block" style="padding: var(--space-4); flex-direction: column; text-align: center; gap: var(--space-3); border-style: dashed; background: transparent;">
      <div class="devnotes-block__text" style="min-width: auto;">
        <h2 id="devnotes-title" style="font-size: var(--text-lg); margin-bottom: var(--space-2);">{tr['devnotes.title'] ?? 'Development notes'}</h2>
        <p style="font-size: var(--text-sm);">{tr['devnotes.body'] ?? 'I write occasional dev notes about KoalaStuff projects and updates on our blog.'}</p>
      </div>
      <a href={getLocalePath(locale, 'blog')} class="btn btn-secondary" style="font-size: var(--text-xs); padding: var(--space-2) var(--space-4);">
        {tr['devnotes.cta'] ?? 'Read dev notes'}
      </a>
    </div>
  </div>
</section>
