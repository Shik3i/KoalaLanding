---
import type { Locale } from '../../i18n/config';
import type { Project } from '../../data/projects';
import { getProjectDescription } from '../../data/projects';
import { Picture } from 'astro:assets';

export interface Props {
  project: Project;
  locale: Locale;
  translations: Record<string, string>;
  reversed?: boolean;
}

const { project, locale, translations: tr, reversed = false } = Astro.props;

const statusClass = `badge--${project.status}`;
const statusLabel = tr[`status.${project.status}`] ?? project.status;
const description = getProjectDescription(project, locale, true);

// Load images dynamically
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projects/**/*.{jpeg,jpg,png,gif,webp,svg}');

const mascotPath = project.assets.mascot ? `/src${project.assets.mascot}` : null;
const mascotImport = mascotPath ? images[mascotPath] : null;
const mascotSrc = mascotImport ? (await mascotImport()).default : null;

const iconPath = project.assets.icon ? `/src${project.assets.icon}` : null;
const isIconSvg = project.assets.icon?.endsWith('.svg');
const iconImport = iconPath ? images[iconPath] : null;
const iconSrc = iconImport ? (await iconImport()).default : null;
---

<article
  class={`featured-project${reversed ? ' featured-project--reversed' : ''}`}
  style={`--project-accent: ${project.accentColor ?? 'var(--c-accent)'}`}
>
  <!-- Text side -->
  <div class="featured-project__text">
    <div class="featured-project__label-wrap">
      <span class="featured-project__label-badge">{tr['featured.label'] ?? 'Featured'}</span>
    </div>

    <h3 class="featured-project__title">{project.name}</h3>

    <p class="featured-project__claim">
      {getProjectDescription(project, locale, false)}
    </p>

    <!-- Visual side (Mobile only) -->
    <div class="featured-project__visual featured-project__visual--mobile" aria-hidden="true">
      <div class="featured-project__window-card">
        <div class="window-header">
          <div class="window-dot window-dot--red"></div>
          <div class="window-dot window-dot--yellow"></div>
          <div class="window-dot window-dot--green"></div>
          <span class="window-title">{project.name}</span>
        </div>
        <div class="window-body">
          <div class="featured-project__image-wrap">
            {mascotSrc ? (
              <Picture
                src={mascotSrc}
                formats={['avif', 'webp']}
                densities={[1, 2]}
                alt=""
                class="featured-project__mascot"
                width={320}
                height={320}
              />
            ) : isIconSvg && project.assets.icon ? (
              <img
                src={project.assets.icon}
                alt=""
                class="featured-project__icon-large"
                width="96"
                height="96"
                loading="lazy"
                decoding="async"
              />
            ) : iconSrc ? (
              <Picture
                src={iconSrc}
                formats={['avif', 'webp']}
                densities={[1, 2]}
                alt=""
                class="featured-project__icon-large"
                width={96}
                height={96}
              />
            ) : null}
          </div>
        </div>
      </div>
    </div>

    <p class="featured-project__desc">{description}</p>

    <div class="featured-project__meta">
      <span class={`badge ${statusClass}`}>
        <svg width="6" height="6" viewBox="0 0 6 6" aria-hidden="true">
          <circle cx="3" cy="3" r="3" fill="currentColor"/>
        </svg>
        {statusLabel}
      </span>
      <div class="tags">
        {project.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>

    <div class="featured-project__links">
      {project.links.website && project.status !== 'wip' && (
        <a href={project.links.website} class="btn btn-primary" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          {tr['featured.visitWebsite'] ?? 'Visit website'}
        </a>
      )}
      {project.links.github && (
        <a href={project.links.github} class="btn btn-secondary" rel="noopener noreferrer">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          {tr['featured.viewOnGitHub'] ?? 'View on GitHub'}
        </a>
      )}
      {(project.links.chrome || project.links.firefox) && project.status !== 'wip' && (
        <div class="featured-project__download-group">
          {project.links.chrome && (
            <a href={project.links.chrome} class="btn btn-ghost" data-link-platform="chrome" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C8.21 0 4.831 1.757 2.632 4.501l3.953 6.848A5.454 5.454 0 0 1 12 6.545h10.691A12 12 0 0 0 12 0zM1.931 5.47A11.943 11.943 0 0 0 0 12c0 6.012 4.42 10.991 10.189 11.864l3.953-6.847a5.45 5.45 0 0 1-6.865-2.29zm13.342 2.166a5.446 5.446 0 0 1 1.45 7.09l.002.001h-.002l-5.344 9.257c.206.01.413.016.621.016 6.627 0 12-5.373 12-12 0-1.54-.29-3.011-.818-4.364zM12 16.364a4.364 4.364 0 1 1 0-8.728 4.364 4.364 0 0 1 0 8.728Z"/>
              </svg>
              {tr['featured.chromeStore'] ?? 'Chrome Web Store'}
            </a>
          )}
          {project.links.firefox && (
            <a href={project.links.firefox} class="btn btn-ghost" data-link-platform="firefox" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8.824 7.287c.008 0 .004 0 0 0zm-2.8-1.4c.006 0 .003 0 0 0zm16.754 2.161c-.505-1.215-1.53-2.528-2.333-2.943.654 1.283 1.033 2.57 1.177 3.53l.002.02c-1.314-3.278-3.544-4.6-5.366-7.477-.091-.147-.184-.292-.273-.446a3.545 3.545 0 01-.13-.24 2.118 2.118 0 01-.172-.46.03.03 0 00-.027-.03.038.038 0 00-.021 0l-.006.001a.037.037 0 00-.01.005L15.624 0c-2.585 1.515-3.657 4.168-3.932 5.856a6.197 6.197 0 00-2.305.587.297.297 0 00-.147.37c.057.162.24.24.396.17a5.622 5.622 0 012.008-.523l.067-.005a5.847 5.847 0 011.957.222l.095.03a5.816 5.816 0 01.616.228c.08.036.16.073.238.112l.107.055a5.835 5.835 0 01.368.211 5.953 5.953 0 012.034 2.104c-.62-.437-1.733-.868-2.803-.681 4.183 2.09 3.06 9.292-2.737 9.02a5.164 5.164 0 01-1.513-.292 4.42 4.42 0 01-.538-.232c-1.42-.735-2.593-2.121-2.74-3.806 0 0 .537-2 3.845-2 .357 0 1.38-.998 1.398-1.287-.005-.095-2.029-.9-2.817-1.677-.422-.416-.622-.616-.8-.767a3.47 3.47 0 00-.301-.227 5.388 5.388 0 01-.032-2.842c-1.195.544-2.124 1.403-2.8 2.163h-.006c-.46-.584-.428-2.51-.402-2.913-.006-.025-.343.176-.389.206-.406.29-.787.616-1.136.974-.397.403-.76.839-1.085 1.303a9.816 9.816 0 00-1.562 3.52c-.003.013-.11.487-.19 1.073-.013.09-.026.181-.037.272a7.8 7.8 0 00-.069.667l-.002.034-.023.387-.001.06C.386 18.795 5.593 24 12.016 24c5.752 0 10.527-4.176 11.463-9.661.02-.149.035-.298.052-.448.232-1.994-.025-4.09-.753-5.844z"/>
              </svg>
              {tr['featured.firefoxAddons'] ?? 'Firefox Add-ons'}
            </a>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Visual side (Desktop only) -->
  <div class="featured-project__visual featured-project__visual--desktop" aria-hidden="true">
    <div class="featured-project__window-card">
      <div class="window-header">
        <div class="window-dot window-dot--red"></div>
        <div class="window-dot window-dot--yellow"></div>
        <div class="window-dot window-dot--green"></div>
        <span class="window-title">{project.name}</span>
      </div>
      <div class="window-body">
        <div class="featured-project__image-wrap">
          {mascotSrc ? (
            <Picture
              src={mascotSrc}
              formats={['avif', 'webp']}
              densities={[1, 2]}
              alt=""
              class="featured-project__mascot"
              width={320}
              height={320}
            />
          ) : isIconSvg && project.assets.icon ? (
            <img
              src={project.assets.icon}
              alt=""
              class="featured-project__icon-large"
              width="96"
              height="96"
              loading="lazy"
              decoding="async"
            />
          ) : iconSrc ? (
            <Picture
              src={iconSrc}
              formats={['avif', 'webp']}
              densities={[1, 2]}
              alt=""
              class="featured-project__icon-large"
              width={96}
              height={96}
            />
          ) : null}
        </div>
      </div>
    </div>
  </div>
</article>
