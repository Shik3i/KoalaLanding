---
import type { Locale } from '../../i18n/config';
import { getLocalePath } from '../../i18n/config';

export interface Props {
  locale: Locale;
  translations: Record<string, string>;
}

const { locale, translations: tr } = Astro.props;
---

<section class="hero" aria-label="Hero">

  <div class="container">
    <div class="hero__content">
      <div class="hero__eyebrow">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <circle cx="8" cy="8" r="3"/>
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.22 3.22l1.42 1.42M11.36 11.36l1.42 1.42M3.22 12.78l1.42-1.42M11.36 4.64l1.42-1.42"/>
        </svg>
        koalastuff.net
      </div>

      <h1 class="hero__title">{tr['hero.headline'] ?? 'KoalaStuff'}</h1>

      <p class="hero__subtitle">{tr['hero.subheadline'] ?? 'Small open-source tools for real annoyances.'}</p>

      <p class="hero__body">{tr['hero.body'] ?? 'Browser extensions, web tools, desktop utilities and experiments built around media, self-hosting, automation and everyday workflows.'}</p>

      <div class="hero__actions">
        <a href={`${getLocalePath(locale)}#projects`} class="btn btn-primary">
          {tr['hero.cta.projects'] ?? 'Explore projects'}
        </a>
        <a href="https://github.com/Shik3i" class="btn btn-secondary" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
          {tr['hero.cta.github'] ?? 'GitHub'}
        </a>
        <a href="https://dev.to/hungrykoala" class="btn btn-ghost" rel="noopener noreferrer">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M7.42 10.05c-.18-.16-.46-.23-.84-.23H6l.02 2.44.04 2.45.56-.02c.41 0 .63-.07.83-.26.24-.24.26-.36.26-2.2 0-1.91-.02-1.96-.29-2.18zM0 4.94v14.12h24V4.94H0zM8.56 15.3c-.44.58-1.06.77-2.53.77H4.71V8.53h1.4c1.67 0 2.16.18 2.6.9.27.43.29.6.32 2.57.05 2.23-.02 2.73-.47 3.3zm5.09-5.47h-2.47v1.77h1.52v1.28l-.72.04-.75.03v1.77l1.22.03 1.2.04v1.28h-1.6c-1.53 0-1.6-.01-1.87-.3l-.3-.28v-3.16c0-3.02.01-3.18.25-3.48.23-.31.25-.31 1.88-.31h1.64v1.29zm4.68 5.45c-.17.43-.64.79-1 .79-.18 0-.45-.15-.67-.39-.32-.32-.45-.63-.82-2.08l-.9-3.39-.45-1.67h.76c.4 0 .75.02.75.05 0 .06 1.16 4.54 1.26 4.83.04.15.32-.7.73-2.3l.66-2.52.74-.04c.4-.02.73 0 .73.04 0 .14-1.67 6.38-1.8 6.68z"/>
          </svg>
          {tr['hero.cta.devto'] ?? 'dev.to'}
        </a>
      </div>

      <p class="hero__note">{tr['hero.note'] ?? 'Made by Timo, a solo developer from Germany.'}</p>
    </div>
  </div>
</section>
