---
import type { Locale } from '../../i18n/config';
import { getFeaturedProjects, getHomepageProjects, sortProjectsByStatusAndDate } from '../../data/projects';
import FeaturedProjectBlock from './FeaturedProjectBlock.astro';
import ProjectCard from '../ProjectCard.astro';

export interface Props {
  locale: Locale;
  translations: Record<string, string>;
}

const { locale, translations: tr } = Astro.props;

const featured = getFeaturedProjects();
const homepageProjects = sortProjectsByStatusAndDate(getHomepageProjects());
const gridProjects = homepageProjects.filter((project) => !project.featured);

const categories = [
  'desktop',
  'web',
  'extensions',
] as const;

const categoryIcons: Record<string, string> = {
  'desktop': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>',
  'web': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>',
  'extensions': '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.706 1.087.706 1.704s-.235 1.233-.706 1.704l-1.611 1.611a.98.98 0 0 1-.837.276c-.47-.07-.802-.48-.968-.925a2.501 2.501 0 1 0-3.214 3.214c.446.166.855.497.925.968a.979.979 0 0 1-.276.837l-1.61 1.611c-.47.47-1.088.706-1.705.706s-1.233-.235-1.704-.706l-1.568-1.568a1.026 1.026 0 0 0-.877-.29c-.493.074-.84.504-1.02.968a2.5 2.5 0 1 1-3.237-3.237c.464-.18.894-.527.967-1.02a1.026 1.026 0 0 0-.289-.877l-1.568-1.568A2.406 2.406 0 0 1 2 12c0-.638.25-1.278.706-1.704l1.568-1.568c.23-.23.338-.556.289-.878-.07-.493-.504-.84-.968-1.02a2.5 2.5 0 1 1 3.237-3.237c.18.464.527.894 1.02.967.322.049.648-.059.877-.289l1.568-1.568A2.406 2.406 0 0 1 12 2c.638 0 1.278.25 1.704.706l1.568 1.568c.23.23.556.338.878.289.493-.07.84-.504 1.02-.968a2.5 2.5 0 1 1 3.237 3.237c-.464.18-.894.527-.967 1.02Z"></path></svg>',
};
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title" id="projects-title">{tr['categories.title'] ?? 'Projects'}</h2>
      <p class="section__subtitle">{tr['categories.intro'] ?? 'All projects are open-source and built around real use cases.'}</p>
    </div>

    <!-- Featured projects (large showcase) -->
    <div aria-label="Featured projects">
      {featured.map((project, i) => (
        <FeaturedProjectBlock
          project={project}
          locale={locale}
          translations={tr}
          reversed={i % 2 !== 0}
        />
      ))}
    </div>

    <!-- Category Filter Tabs & Toggle -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-4);">
      <nav class="project-filter" role="tablist" aria-label={tr['categories.title'] ?? 'Project categories'}>
        <button
          class="filter-btn active"
          role="tab"
          aria-selected="true"
          tabindex="0"
          aria-controls="homepage-project-grid"
          data-category="all"
          data-desc={tr['categories.all.desc'] ?? 'All open-source tools and utilities built by KoalaStuff.'}
          title={tr['categories.all'] ?? 'All'}
        >
          {tr['categories.all'] ?? 'All'}
        </button>
        {categories.map((cat) => {
          const catProjects = gridProjects.filter((p) => p.category === cat);
          if (catProjects.length === 0) return null;
          return (
            <button
              class="filter-btn"
              role="tab"
              aria-selected="false"
              tabindex="-1"
              aria-controls="homepage-project-grid"
              data-category={cat}
              data-desc={tr[`categories.${cat}.desc`] ?? ''}
              title={tr[`categories.${cat}`] ?? cat}
            >
              <span aria-hidden="true" set:html={categoryIcons[cat]} style="display: flex;"></span>
              {tr[`categories.${cat}`] ?? cat}
            </button>
          );
        })}
      </nav>

      <div class="experimental-toggle-container" id="experimental-toggle-container">
        <button id="experimental-toggle-btn" class="btn btn-ghost" aria-expanded="false" aria-controls="homepage-project-grid" title={tr['projects.disclaimerText'] ?? 'These projects are Work In Progress or experimental. They may have bugs and are not yet intended for general public use. Use at your own risk!'} style="padding: 0.4em 0.8em; font-size: var(--text-xs); border: 1px dashed var(--c-border);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 2v7.31"></path><path d="M14 9.3V1.99"></path><path d="M8.5 2h7"></path><path d="M14 9.3a6.5 6.5 0 1 1-4 0"></path><path d="M5.52 16h12.96"></path></svg>
          <span>{tr['projects.showExperimentalShort'] ?? 'Show WIP / Experimental'}</span>
        </button>
      </div>
    </div>
    
    <div class="category-header" style="margin-top: var(--space-4);">
      <p class="category-header__desc">
        {tr['categories.all.desc'] ?? 'All open-source tools and utilities built by KoalaStuff.'}
      </p>
    </div>

    <div id="experimental-disclaimer" class="experimental-disclaimer" aria-hidden="true" style="margin-bottom: var(--space-6);">
      <div class="disclaimer-content">
        <strong>⚠️ {tr['projects.disclaimerTitle'] ?? 'Disclaimer'}:</strong> 
        {tr['projects.disclaimerText'] ?? 'These projects are heavily Work In Progress or experimental proofs of concept. They may have bugs, lack documentation, and are not yet intended for general public use. Use them at your own risk!'}
      </div>
    </div>

    <!-- Unified projects grid -->
    <div class="project-grid" id="homepage-project-grid">
      {gridProjects.map((project) => (
        <div class="project-grid-item" data-category={project.category} data-experimental={['wip', 'experimental'].includes(project.status) ? 'true' : 'false'}>
          <ProjectCard project={project} locale={locale} translations={tr} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .experimental-toggle-container {
    display: flex;
    align-items: center;
  }

  .experimental-disclaimer {
    max-width: 600px;
    background: hsla(30, 90%, 50%, 0.1);
    border: 1px solid hsla(30, 90%, 50%, 0.3);
    color: var(--c-text);
    padding: 0 var(--space-4);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-align: center;
    opacity: 0;
    visibility: hidden;
    height: 0;
    overflow: hidden;
    transition: opacity var(--dur-base) var(--ease-out), visibility var(--dur-base) var(--ease-out), height var(--dur-base) var(--ease-out), padding var(--dur-base) var(--ease-out);
  }

  .experimental-disclaimer strong {
    color: hsla(30, 90%, 60%, 1);
  }

  .experimental-toggle-container.is-active #experimental-toggle-btn {
    border-color: hsla(30, 90%, 50%, 0.5) !important;
    background: hsla(30, 90%, 50%, 0.1);
    color: hsla(30, 90%, 65%, 1);
  }
  
  .experimental-disclaimer.is-active {
    opacity: 1;
    visibility: visible;
    padding: var(--space-4);
  }

  /* Hide experimental items initially */
  #homepage-project-grid:not(.show-experimental) .project-grid-item[data-experimental="true"] {
    display: none;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggleBtn = document.getElementById('experimental-toggle-btn');
    const toggleContainer = document.getElementById('experimental-toggle-container');
    const projectGrid = document.getElementById('homepage-project-grid');
    const disclaimer = document.getElementById('experimental-disclaimer');
    if (!toggleBtn || !projectGrid || !toggleContainer) return;

    const getSavedState = () => {
      try {
        return localStorage.getItem('koalastuff_show_experimental');
      } catch {
        return null;
      }
    };
    const saveState = (value: boolean) => {
      try {
        localStorage.setItem('koalastuff_show_experimental', String(value));
      } catch {
        // Storage may be unavailable in private or restricted browsing contexts.
      }
    };

    const savedState = getSavedState();
    let isShowing = savedState === 'true';

    const updateDOM = () => {
      if (isShowing) {
        projectGrid.classList.add('show-experimental');
        toggleContainer.classList.add('is-active');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (disclaimer) {
          disclaimer.classList.add('is-active');
          disclaimer.setAttribute('aria-hidden', 'false');
          disclaimer.style.height = disclaimer.scrollHeight + 32 + 'px'; // +32 for padding
          setTimeout(() => { if(isShowing) disclaimer.style.height = 'auto'; }, 300);
        }
        
        // Ensure newly revealed items get animated
        setTimeout(() => {
          const newItems = projectGrid.querySelectorAll('.project-grid-item[data-experimental="true"] .reveal-on-scroll');
          newItems.forEach(el => el.classList.add('is-revealed'));
        }, 50);

      } else {
        projectGrid.classList.remove('show-experimental');
        toggleContainer.classList.remove('is-active');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (disclaimer) {
          disclaimer.classList.remove('is-active');
          disclaimer.setAttribute('aria-hidden', 'true');
          disclaimer.style.height = '0px';
        }
      }
    };

    updateDOM();

    toggleBtn.addEventListener('click', () => {
      isShowing = !isShowing;
      saveState(isShowing);
      
      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const main = document.getElementById('main-content');
        if (main) main.style.viewTransitionName = 'none';

        const transition = document.startViewTransition(() => updateDOM());
        
        transition.finished.finally(() => {
          if (main) main.style.viewTransitionName = '';
        });
      } else {
        updateDOM();
      }
    });
  });
</script>
