---
export interface Props {
  translations: Record<string, string>;
}
const { translations: tr } = Astro.props;

const items = [
  {
    key: 'opensource',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`,
  },
  {
    key: 'notracking',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="9" y1="12" x2="15" y2="12"/></svg>`,
  },
  {
    key: 'realusecases',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
  },
  {
    key: 'honest',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>`,
  },
];
---

<section class="section section--tight section--centered" aria-labelledby="trust-title">
  <div class="container">
    <div class="section__header section__header--centered">
      <h2 class="section__title" id="trust-title">{tr['trust.title'] ?? 'Why trust these projects?'}</h2>
    </div>
    <div class="trust-grid">
      {items.map((item) => (
        <div class="trust-item">
          <div class="trust-item__icon" set:html={item.icon} aria-hidden="true"></div>
          <h3 class="trust-item__title">{tr[`trust.${item.key}.title`] ?? item.key}</h3>
          <p class="trust-item__desc">{tr[`trust.${item.key}.desc`] ?? ''}</p>
        </div>
      ))}
    </div>
  </div>
</section>
