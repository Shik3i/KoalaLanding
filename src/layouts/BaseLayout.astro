---
import '../styles/global.css';
import '../styles/components.css';
import { locales, localeLangCodes, localeNames, getLocalePath, defaultLocale } from '../i18n/config';
import type { Locale } from '../i18n/config';
import { ClientRouter } from 'astro:transitions';
import BackToTop from '../components/BackToTop.astro';
import { loadTranslations } from '../i18n/utils';
import { getListedProjects, getProjectDescription, getProjectSlug } from '../data/projects';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath?: string;
  ogImage?: string;
}

const {
  title,
  description,
  locale,
  canonicalPath = '/',
  ogImage = '/assets/brand/og-preview.png',
} = Astro.props;

const siteUrl = 'https://koalastuff.net';
const canonicalUrl = `${siteUrl}${canonicalPath}`.replace(/\/$/, '') || siteUrl;
const ogImageUrl = `${siteUrl}${ogImage}`;
const langCode = localeLangCodes[locale];
const defaultLocalePath = getLocalePath(
  defaultLocale,
  canonicalPath.replace(/^\/?(de|fr|es|it|nl|pl|pt-BR|pt|tr|ru|ja|ko|zh|uk)(\/|$)/, ''),
);

const isHomepage = canonicalPath === '/' || locales.some((l) => canonicalPath === `/${l}` || canonicalPath === `/${l}/`);
const isProjectsPage = canonicalPath.endsWith('/projects') || canonicalPath.endsWith('/projects/');

const tr = await loadTranslations(locale);

const graph: any[] = [
  {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    "name": "KoalaStuff",
    "url": siteUrl,
    "logo": `${siteUrl}/favicon.svg`,
    "sameAs": [
      "https://github.com/Shik3i",
      "https://dev.to/hungrykoala",
      "https://mastodon.social/@koalastuff"
    ]
  },
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": siteUrl,
    "name": "KoalaStuff",
    "description": "Small open-source tools for real annoyances.",
    "inLanguage": langCode,
    "publisher": { "@id": `${siteUrl}/#organization` },
    "author": { "@id": `${siteUrl}/#person` }
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    "name": "Timo",
    "url": "https://github.com/Shik3i",
    "sameAs": [
      "https://github.com/Shik3i",
      "https://dev.to/hungrykoala",
      "https://mastodon.social/@koalastuff"
    ]
  }
];

if (isHomepage) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${siteUrl}${canonicalPath}#faq`,
    "mainEntity": [
      {
        "@type": "Question",
        "name": tr["faq.q1"] ?? "What is KoalaStuff?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a1"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q2"] ?? "Who builds KoalaStuff?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a2"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q3"] ?? "Are the projects open source?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a3"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q4"] ?? "Are the projects free?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a4"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q5"] ?? "Where can I report bugs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a5"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q6"] ?? "Do you use tracking or cookies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a6"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q7"] ?? "Can I self-host KoalaStuff projects?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a7"] ?? ""
        }
      },
      {
        "@type": "Question",
        "name": tr["faq.q8"] ?? "Why are some projects marked experimental?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": tr["faq.a8"] ?? ""
        }
      }
    ].filter(q => q.name && q.acceptedAnswer.text)
  });
}

if (isProjectsPage) {
  const listedProjects = getListedProjects();
  graph.push({
    "@type": "ItemList",
    "@id": `${siteUrl}${canonicalPath}#project-list`,
    "name": tr["nav.projects"] ?? "Projects",
    "description": tr["categories.all.desc"] ?? "All open-source tools and utilities",
    "numberOfItems": listedProjects.length,
    "itemListElement": listedProjects.map((project, idx) => {
      const slug = getProjectSlug(project);
      const projectUrl = `${siteUrl}${getLocalePath(locale, `projects/${slug}`)}`;
      return {
        "@type": "ListItem",
        "position": idx + 1,
        "item": {
          "@type": "SoftwareApplication",
          "@id": `${projectUrl}#software`,
          "name": project.name,
          "description": getProjectDescription(project, locale),
          "applicationCategory": project.category === 'desktop' ? 'DesktopApplication' : project.category === 'web' ? 'WebApplication' : 'BrowserApplication',
          "operatingSystem": "All",
          "url": projectUrl
        }
      };
    })
  });
}
---

<!doctype html>
<html lang={langCode} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="referrer" content="no-referrer-when-downgrade" />
    <meta name="author" content="Timo (KoalaStuff)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark light" />
    <meta id="theme-color" name="theme-color" content="#0d0d0d" />
    <meta name="darkreader-lock" />
    <ClientRouter />

    <!-- Geotargeting -->
    <meta name="geo.region" content="DE" />
    <meta name="geo.position" content="51.165691;10.451526" />
    <meta name="ICBM" content="51.165691, 10.451526" />

    <!-- Canonical, hreflang, Sitemap & RSS -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="KoalaStuff Blog" href={`${siteUrl}/rss.xml`} />
    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={localeLangCodes[l]}
        href={`${siteUrl}${getLocalePath(l, canonicalPath.replace(/^\/?(de|fr|es|it|nl|pl|pt-BR|pt|tr|ru|ja|ko|zh|uk)(\/|$)/, ''))}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${defaultLocalePath}`} />
    <link rel="manifest" href="/manifest.json" />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KoalaStuff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={langCode.replace('-', '_')} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Font preloads (self-hosted Inter) -->
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/inter-700.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- JSON-LD: WebSite + Person + Organization (+ FAQ/Projects if applicable) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": graph
    })} />

    <!-- Anti-flash theme script (loaded blocking from 'self' to prevent flash before render) -->
    <script is:inline src="/anti-flash.js"></script>
  </head>
  <body>
    <!-- Ambient background glow blobs -->
    <div class="bg-glow-blobs" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <!-- Interactive Canvas Particle Grid -->
    <canvas id="bg-canvas" class="bg-canvas" aria-hidden="true" transition:persist="background-canvas"></canvas>

    <!-- Skip link for keyboard users -->
    <a href="#main-content" class="skip-link" title={locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}>{locale === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}</a>

    <slot />

    <BackToTop />

    <!-- Theme + UI script (Astro bundles this as a static asset) -->
    <script>
      import '../scripts/theme.ts';
    </script>
    <script>
      let pageObserver = null;
      let isInitialLoad = true;
      document.addEventListener('astro:before-preparation', (event) => {
        const fromPath = event.from.pathname || new URL(event.from, location.href).pathname;
        const toPath = event.to.pathname || new URL(event.to, location.href).pathname;

        const getOrder = (p) => {
          if (p === '/' || p.match(/^\/[a-z]{2}\/?$/)) return 0;
          if (p.includes('/projects')) return 1;
          if (p.includes('/blog')) return 2;
          return 99; // Legal pages
        };

        const fromOrder = getOrder(fromPath);
        const toOrder = getOrder(toPath);
        const doc = document.documentElement;

        if (fromOrder < 99 && toOrder < 99) {
          doc.setAttribute('data-transition-type', 'horizontal');
          if (fromOrder === toOrder) {
            const fromDepth = fromPath.split('/').filter(Boolean).length;
            const toDepth = toPath.split('/').filter(Boolean).length;
            event.direction = toDepth >= fromDepth ? 'forward' : 'back';
          } else {
            event.direction = toOrder > fromOrder ? 'forward' : 'back';
          }
        } else if (toOrder === 99 && fromOrder !== 99) {
          doc.setAttribute('data-transition-type', 'vertical-up');
        } else if (fromOrder === 99 && toOrder < 99) {
          doc.setAttribute('data-transition-type', 'vertical-down');
        } else if (fromOrder === 99 && toOrder === 99) {
          doc.setAttribute('data-transition-type', 'fade');
        }
      });

      // CRITICAL: Astro removes custom attributes from <html> during the DOM swap
      // because the new server-rendered HTML doesn't have them. We must copy them!
      document.addEventListener('astro:before-swap', (event) => {
        const type = document.documentElement.getAttribute('data-transition-type');
        if (type) {
          event.newDocument.documentElement.setAttribute('data-transition-type', type);
        }
      });

      document.addEventListener('astro:page-load', () => {
        if (pageObserver) pageObserver.disconnect();
        pageObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              pageObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal-on-scroll').forEach(el => pageObserver.observe(el));

        // Move focus to main content after view transitions
        const main = document.getElementById('main-content');
        if (!isInitialLoad && main && document.activeElement && !main.contains(document.activeElement)) {
          main.setAttribute('tabindex', '-1');
          main.focus({ preventScroll: true });
          main.addEventListener('blur', () => main.removeAttribute('tabindex'), { once: true });
        }
        isInitialLoad = false;
      });
    </script>
  </body>
</html>
