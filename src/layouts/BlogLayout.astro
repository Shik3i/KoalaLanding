---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/config';
import { loadTranslations } from '../i18n/utils';
import { getLocalePath } from '../i18n/config';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  pubDate?: Date;
  author?: string;
  ogImage?: string;
}

const { title, description, locale, canonicalPath, pubDate, author, ogImage } = Astro.props;
const tr = await loadTranslations(locale);
---

<BaseLayout
  title={`${title} — KoalaStuff Blog`}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
>
  <Header locale={locale} translations={tr} currentPath={canonicalPath} />

  <main id="main-content" class="section blog-layout">
    <div class="container container--blog">
      
      <a href={getLocalePath(locale, 'blog')} class="btn btn-ghost blog-back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        {tr['blog.back'] ?? 'Back to Overview'}
      </a>

      <article class="blog-article">
        <header class="blog-header">
          <h1 class="blog-title">{title}</h1>
          
          {(pubDate || author) && (
            <div class="blog-meta">
              {pubDate && (
                <time datetime={pubDate.toISOString()}>
                  {pubDate.toLocaleDateString(locale === 'en' ? 'en-US' : locale, {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
              )}
              {pubDate && author && <span class="meta-separator">•</span>}
              {author && <span class="blog-author">{author}</span>}
            </div>
          )}
        </header>

        <div class="blog-content">
          <slot />
        </div>
      </article>

    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>

<style>
  .container--blog {
    max-width: 800px;
  }
  
  .blog-layout {
    padding-top: var(--space-12);
  }

  .blog-back-link {
    display: inline-flex;
    margin-bottom: var(--space-8);
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
  }
  .blog-back-link:hover {
    background: transparent;
    color: var(--c-text);
  }

  .blog-header {
    margin-bottom: var(--space-10);
  }

  .blog-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-text-muted);
    font-size: var(--text-sm);
  }

  .meta-separator {
    opacity: 0.5;
  }

  /* Basic Markdown Styling inside blog-content */
  .blog-content {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--c-text);
  }
  
  .blog-content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }
  
  .blog-content :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  
  .blog-content :global(p) {
    margin-bottom: var(--space-6);
  }
  
  .blog-content :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--c-border);
    text-underline-offset: 4px;
  }
  .blog-content :global(a:hover) {
    text-decoration-color: var(--c-accent);
  }
  
  .blog-content :global(ul), .blog-content :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }
  
  .blog-content :global(li) {
    margin-bottom: var(--space-2);
    list-style: disc;
  }
  
  .blog-content :global(blockquote) {
    border-left: 4px solid var(--c-accent);
    padding-left: var(--space-4);
    margin: var(--space-8) 0;
    color: var(--c-text-muted);
    font-style: italic;
    background: hsla(var(--c-accent), 0.1);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  
  .blog-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--c-surface-alt);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
  }
  
  .blog-content :global(pre) {
    background: var(--c-bg-alt);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }
  
  .blog-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.9em;
  }

  .blog-content :global(img) {
    border-radius: var(--radius-md);
    margin-block: var(--space-8);
  }
</style>
