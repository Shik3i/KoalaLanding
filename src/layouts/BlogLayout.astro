---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/config';
import { loadTranslations } from '../i18n/utils';
import { getLocalePath, localeLangCodes } from '../i18n/config';

export interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  pubDate?: Date;
  author?: string;
  ogImage?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, locale, canonicalPath, pubDate, author, ogImage, headings = [] } = Astro.props;
const tr = await loadTranslations(locale);
const langCode = localeLangCodes[locale];
const siteUrl = 'https://koalastuff.net';
const ogImageUrl = `${siteUrl}${ogImage || '/assets/brand/og-preview.png'}`;
const canonicalUrl = `${siteUrl}${canonicalPath}`.replace(/\/$/, '') || siteUrl;
---

<BaseLayout
  title={`${title} — KoalaStuff Blog`}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
>
  <Header locale={locale} translations={tr} currentPath={canonicalPath} />

  <!-- Reading Progress Bar (outside main to avoid view-transition transform issues) -->
  <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

  <main id="main-content" class="section blog-layout" transition:animate="slide">

    <div class="container container--blog">
      
      <a href={getLocalePath(locale, 'blog')} class="btn btn-ghost blog-back-link" title="Back to blog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        {tr['blog.back'] ?? 'Back to Overview'}
      </a>

      <article class="blog-article">
        <header class="blog-header">
          <h1 class="blog-title">{title}</h1>
          
          {(pubDate || author) && (
            <div class="blog-meta-wrapper" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <div class="blog-meta">
                {pubDate && (
                  <time datetime={pubDate.toISOString()}>
                    {pubDate.toLocaleDateString(locale === 'en' ? 'en-US' : locale, {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric'
                    })}
                  </time>
                )}
                {pubDate && author && <span class="meta-separator">•</span>}
                {author && <span class="blog-author">{author}</span>}
              </div>
              <div style="display: flex; gap: 0.5rem;">
                <button id="copy-md-btn" class="copy-link-btn" type="button" aria-label="Copy markdown">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px; display: inline-block; vertical-align: middle;"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                  <span>Markdown</span>
                </button>
                <button id="copy-link-btn" class="copy-link-btn" type="button" aria-label="Copy link">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-right: 4px; display: inline-block; vertical-align: middle;"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  <span>Link</span>
                </button>
              </div>
              <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
            </div>
          )}
        </header>

        <div class="blog-layout-grid">
          <div class="blog-content">
            <slot />
          </div>

          {headings.length > 0 && (
            <aside class="blog-sidebar">
              <div class="blog-toc">
                <h3 class="blog-toc__title">{tr['blog.toc'] ?? 'Table of Contents'}</h3>
                <ul>
                  {headings.filter(h => h.depth > 1 && h.depth < 4).map(h => (
                    <li class={`toc-depth-${h.depth}`}>
                      <a href={`#${h.slug}`} title={h.text}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </div>
            </aside>
          )}
        </div>
      </article>

      <script is:inline type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title,
        "description": description,
        "datePublished": pubDate ? pubDate.toISOString() : undefined,
        "author": {
          "@type": "Person",
          "@id": "https://koalastuff.net/#person",
          "name": author ?? "Timo",
          "url": "https://github.com/Shik3i",
          "sameAs": [
            "https://github.com/Shik3i",
            "https://dev.to/hungrykoala",
            "https://mastodon.social/@koalastuff"
          ]
        },
        "publisher": {
          "@type": "Organization",
          "@id": "https://koalastuff.net/#organization",
          "name": "KoalaStuff",
          "logo": {
            "@type": "ImageObject",
            "url": "https://koalastuff.net/favicon.svg"
          }
        },
        "inLanguage": langCode,
        "mainEntityOfPage": canonicalUrl,
        "image": ogImageUrl
      })} />

    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 0%;
    height: 4px;
    background: var(--c-accent);
    z-index: 1000;
  }

  .container--blog {
    max-width: 1100px;
  }
  
  .blog-layout {
    padding-top: var(--space-12);
  }

  .blog-back-link {
    display: inline-flex;
    margin-bottom: var(--space-8);
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
  }
  .blog-back-link:hover {
    background: transparent;
    color: var(--c-text);
  }

  .blog-header {
    margin-bottom: var(--space-10);
    max-width: 800px;
  }

  .blog-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--c-text-muted);
    font-size: var(--text-sm);
  }

  .meta-separator {
    opacity: 0.5;
  }

  .copy-link-btn {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: 1px solid var(--c-border);
    color: var(--c-text-muted);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }
  .copy-link-btn:hover {
    background: var(--c-surface);
    color: var(--c-text);
    border-color: var(--c-border-subtle);
  }

  .blog-layout-grid {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-12);
  }

  .blog-sidebar {
    display: none;
  }

  @media (min-width: 1024px) {
    .blog-layout-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: var(--space-16);
      align-items: start;
    }

    .blog-sidebar {
      display: block;
      position: sticky;
      top: calc(3.5rem + var(--space-8));
    }
  }

  .blog-toc {
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .blog-toc__title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--c-text);
  }

  .blog-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .blog-toc li a {
    color: var(--c-text-muted);
    text-decoration: none;
    font-size: var(--text-sm);
    transition: color var(--dur-fast);
  }

  .blog-toc li a:hover {
    color: var(--c-accent);
  }

  .toc-depth-3 {
    padding-left: var(--space-4);
  }

  /* Basic Markdown Styling inside blog-content */
  .blog-content {
    font-size: var(--text-lg);
    line-height: 1.7;
    color: var(--c-text);
  }
  
  .blog-content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
    letter-spacing: -0.01em;
  }
  
  .blog-content :global(h3) {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  
  .blog-content :global(p) {
    margin-bottom: var(--space-6);
  }
  
  .blog-content :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--c-border);
    text-underline-offset: 4px;
  }
  .blog-content :global(a:hover) {
    text-decoration-color: var(--c-accent);
  }
  
  .blog-content :global(ul), .blog-content :global(ol) {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
  }
  
  .blog-content :global(li) {
    margin-bottom: var(--space-2);
    list-style: disc;
  }
  
  .blog-content :global(blockquote) {
    border-left: 4px solid var(--c-accent);
    padding-left: var(--space-4);
    margin: var(--space-8) 0;
    color: var(--c-text-muted);
    font-style: italic;
    background: hsla(var(--c-accent), 0.1);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  
  .blog-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--c-surface-alt);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
  }
  
  .blog-content :global(pre) {
    background: var(--c-bg-alt);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    overflow-x: auto;
    margin-bottom: var(--space-6);
  }
  
  .blog-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.9em;
  }

  .blog-content :global(img) {
    border-radius: 4px;
    margin-bottom: var(--space-4);
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  let blogLayoutController: AbortController | null = null;
  document.addEventListener('astro:page-load', () => {
    if (blogLayoutController) blogLayoutController.abort();
    blogLayoutController = new AbortController();
    const signal = blogLayoutController.signal;

    const copyBtn = document.getElementById('copy-link-btn');
    const copyMdBtn = document.getElementById('copy-md-btn');
    const copyStatus = document.getElementById('copy-status');
    
    if (copyMdBtn) {
      copyMdBtn.addEventListener('click', async () => {
        try {
          const mdUrl = window.location.pathname.replace(/\/$/, '') + '.md';
          const res = await fetch(mdUrl);
          if (!res.ok) throw new Error('Failed to fetch markdown');
          const text = await res.text();
          await navigator.clipboard.writeText(text);
          const span = copyMdBtn.querySelector('span');
          if (span) {
            const original = span.textContent;
            span.textContent = ' Copied!';
            if (copyStatus) copyStatus.textContent = 'Copied Markdown!';
            setTimeout(() => {
              span.textContent = original;
              if (copyStatus) copyStatus.textContent = '';
            }, 2000);
          }
        } catch (err) {
          console.error(err);
        }
      }, { signal });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const span = copyBtn.querySelector('span');
        if (span) {
          const original = span.textContent;
          span.textContent = ' Copied!';
          if (copyStatus) copyStatus.textContent = 'Copied!';
          setTimeout(() => {
            span.textContent = original;
            if (copyStatus) copyStatus.textContent = '';
          }, 2000);
        }
      }, { signal });
    }

    const progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      let ticking = false;
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (docHeight > 0) {
          const progress = Math.min((scrollTop / docHeight) * 100, 100);
          progressBar.style.width = progress + '%';
        }
        ticking = false;
      };
      const onScroll = () => {
        if (!ticking) {
          requestAnimationFrame(updateProgress);
          ticking = true;
        }
      };
      window.addEventListener('scroll', onScroll, { signal, passive: true });
      updateProgress();
    }
  });
</script>
