---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadTranslations } from '../i18n/utils';
import { defaultLocale, getLocalePath } from '../i18n/config';

const locale = defaultLocale;
const tr = await loadTranslations(locale);
---

<BaseLayout
  title="404 — Page Not Found | KoalaStuff"
  description="The requested page could not be found."
  locale={locale}
  canonicalPath="/404/"
>
  <Header locale={locale} translations={tr} currentPath="/404/" />

  <main id="main-content" transition:name="main" transition:animate="slide">
    <div class="container" style="min-height: 55vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: var(--space-8, 4rem) var(--space-4, 1rem);">
      <div style="font-size: clamp(4rem, 10vw, 7rem); font-weight: 800; line-height: 1; color: var(--c-accent, #56ae6c); margin-bottom: var(--space-3, 1rem); letter-spacing: -2px;">
        404
      </div>
      <h1 style="font-size: clamp(1.5rem, 4vw, 2.25rem); font-weight: 700; margin-bottom: var(--space-2, 0.5rem); letter-spacing: -0.5px;">
        {tr['404.title'] ?? 'Page not found'}
      </h1>
      <p style="font-size: var(--text-base, 1rem); color: var(--c-text-muted, #888); max-width: 480px; margin-bottom: var(--space-6, 2rem); line-height: 1.6;">
        {tr['404.description'] ?? 'The page you are looking for does not exist or may have been moved.'}
      </p>
      <div style="display: flex; gap: var(--space-3, 0.75rem); flex-wrap: wrap; justify-content: center;">
        <a href={getLocalePath(locale)} class="btn btn-primary" title="Home">
          {tr['nav.home'] ?? 'Back to Home'}
        </a>
        <a href={getLocalePath(locale, 'projects')} class="btn btn-secondary" title="Projects">
          {tr['nav.projects'] ?? 'Browse Projects'}
        </a>
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>
