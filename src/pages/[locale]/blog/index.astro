---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { loadTranslations } from '../../../i18n/utils';
import { locales, getLocalePath } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';

export async function getStaticPaths() {
  return locales
    .filter((l) => l !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const tr = await loadTranslations(locale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const canonicalPath = getLocalePath(locale, 'blog');
---

<BaseLayout
  title={`Blog — KoalaStuff`}
  description={tr['site.description'] ?? 'Updates, deep-dives and thoughts from KoalaStuff.'}
  locale={locale}
  canonicalPath={canonicalPath}
>
  <Header locale={locale} translations={tr} currentPath={canonicalPath} />

  <main id="main-content" class="section">
    <div class="container container--blog-index">
      <div class="section__header" style="margin-bottom: var(--space-12);">
        <h1 class="section__title">Blog</h1>
        <p class="section__subtitle">
          Updates, deep-dives and thoughts around open-source, web development and automation.
        </p>
      </div>

      <div class="blog-grid">
        {sortedPosts.map(post => (
          <a href={getLocalePath(locale, `blog/${post.slug}`)} class="blog-card card">
            <h2 class="blog-card__title">{post.data.title}</h2>
            <div class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString(locale, {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
            <p class="blog-card__desc">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>

<style>
  .container--blog-index {
    max-width: 800px;
  }
  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .blog-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover {
    text-decoration: none;
  }
  .blog-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--c-text);
    transition: color 0.2s ease;
  }
  .blog-card:hover .blog-card__title {
    color: var(--c-accent);
  }
  .blog-card__meta {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    margin-bottom: var(--space-3);
  }
  .blog-card__desc {
    font-size: var(--text-base);
    color: var(--c-text-faint);
    line-height: 1.6;
  }
</style>
