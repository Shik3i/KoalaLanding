---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/sections/Hero.astro';
import Projects from '../../components/sections/Projects.astro';
import About from '../../components/sections/About.astro';
import Trust from '../../components/sections/Trust.astro';
import DevNotes from '../../components/sections/DevNotes.astro';
import FAQ from '../../components/sections/FAQ.astro';
import { loadTranslations } from '../../i18n/utils';
import { locales, getLocalePath } from '../../i18n/config';
import type { Locale } from '../../i18n/config';

export async function getStaticPaths() {
  // All locales except English (which is at /)
  return locales
    .filter((l) => l !== 'en')
    .map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const tr = await loadTranslations(locale);
const canonicalPath = getLocalePath(locale);
---

<BaseLayout
  title={tr['site.title'] ?? 'KoalaStuff — Small open-source tools for real annoyances'}
  description={tr['site.description'] ?? 'Browser extensions, web tools, desktop utilities and experiments.'}
  locale={locale}
  canonicalPath={canonicalPath}
>
  <Header locale={locale} translations={tr} currentPath={canonicalPath} />

  <main id="main-content">
    <Hero locale={locale} translations={tr} />
    <Projects locale={locale} translations={tr} />
    <About translations={tr} />
    <Trust translations={tr} />
    <DevNotes translations={tr} />
    <FAQ translations={tr} />
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>
