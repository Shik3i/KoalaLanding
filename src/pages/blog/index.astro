---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { loadTranslations } from '../../i18n/utils';
import { defaultLocale } from '../../i18n/config';

const locale = defaultLocale;
const tr = await loadTranslations(locale);

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Blog — KoalaStuff`}
  description={tr['site.description'] ?? 'Updates, deep-dives and thoughts from KoalaStuff.'}
  locale={locale}
  canonicalPath="/blog"
>
  <Header locale={locale} translations={tr} currentPath="/blog" />

  <main id="main-content" class="section" transition:animate="slide">
    <div class="container container--blog-index">
      <div class="section__header" style="margin-bottom: var(--space-12);">
        <div style="display: flex; align-items: center; justify-content: space-between;">
          <h1 class="section__title" style="margin-bottom: 0;">Blog</h1>
          <a href="/rss.xml" class="rss-link" title="RSS Feed" aria-label="RSS Feed">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11a9 9 0 0 1 9 9"></path>
              <path d="M4 4a16 16 0 0 1 16 16"></path>
              <circle cx="5" cy="19" r="1"></circle>
            </svg>
          </a>
        </div>
        <p class="section__subtitle">
          Updates, deep-dives and thoughts around open-source, web development and automation.
        </p>
      </div>

      <div class="blog-grid">
        {sortedPosts.map(post => (
          <a href={`/blog/${post.id}`} class="blog-card card reveal-on-scroll">
            <h2 class="blog-card__title">{post.data.title}</h2>
            <div class="blog-card__meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}
              </time>
            </div>
            <p class="blog-card__desc">{post.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>

<style>
  .container--blog-index {
    max-width: 800px;
  }
  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .blog-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .blog-card:hover {
    text-decoration: none;
  }
  .blog-card__title {
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-2);
    color: var(--c-text);
    transition: color 0.2s ease;
  }
  .blog-card:hover .blog-card__title {
    color: var(--c-accent);
  }
  .blog-card__meta {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    margin-bottom: var(--space-3);
  }
  .blog-card__desc {
    font-size: var(--text-base);
    color: var(--c-text-faint);
    line-height: 1.6;
  }
  .rss-link {
    display: inline-flex;
    padding: var(--space-2);
    border-radius: var(--radius-md);
    color: var(--c-text-muted);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    transition: all 0.2s ease;
  }
  .rss-link:hover {
    color: hsl(25, 90%, 60%);
    border-color: hsl(25, 90%, 60%);
    box-shadow: 0 4px 12px hsla(25, 90%, 60%, 0.15);
    transform: translateY(-2px);
  }
</style>
