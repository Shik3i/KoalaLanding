---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { loadTranslations } from '../../../i18n/utils';

const locale = 'de' as const;
const tr = await loadTranslations(locale);
---

<BaseLayout
  title="Legal Notice | KoalaStuff"
  description="Das KoalaStuff-Impressum ist an die zentrale Adresse umgezogen."
  locale={locale}
  canonicalPath="/legal/"
>
  <Header locale={locale} translations={tr} currentPath="/legal/" />

  <main id="main-content" transition:name="main" transition:animate="slide">
    <div class="container">
      <article class="legal-content">
        <h1>Impressum umgezogen</h1>
        <p>Das KoalaStuff-Impressum ist jetzt unter einer zentralen Adresse verfügbar.</p>
        <p><a href="https://koalastuff.net/legal">Zentrales Impressum öffnen</a></p>
      </article>
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>
