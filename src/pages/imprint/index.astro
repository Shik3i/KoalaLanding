---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { loadTranslations } from '../../i18n/utils';

const locale = 'en' as const;
const tr = await loadTranslations(locale);
---

<BaseLayout
  title="Legal Notice | KoalaStuff"
  description="The KoalaStuff legal notice has moved to its central location."
  locale={locale}
  canonicalPath="/legal/"
>
  <Header locale={locale} translations={tr} currentPath="/legal/" />

  <main id="main-content" transition:name="main" transition:animate="slide">
    <div class="container">
      <article class="legal-content">
        <h1>Legal notice moved</h1>
        <p>The KoalaStuff legal notice is now available at one central address.</p>
        <p><a href="https://koalastuff.net/legal">Open the central legal notice</a></p>
      </article>
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>
