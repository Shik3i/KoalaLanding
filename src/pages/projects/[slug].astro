---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import { getListedProjects, getProjectDescription, getProjectSlug } from '../../data/projects';
import { loadTranslations } from '../../i18n/utils';
import { defaultLocale } from '../../i18n/config';

export async function getStaticPaths() {
  return getListedProjects().map((project) => ({
    params: { slug: getProjectSlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;
const locale = defaultLocale;
const tr = await loadTranslations(locale);
const slug = getProjectSlug(project);
const canonicalPath = `/projects/${slug}`;
const description = getProjectDescription(project, locale);
const siteUrl = 'https://koalastuff.net';

const jsonLdData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${siteUrl}${canonicalPath}#software`,
  name: project.name,
  description,
  applicationCategory: project.category === 'desktop' ? 'DesktopApplication' : project.category === 'web' ? 'WebApplication' : 'BrowserApplication',
  operatingSystem: 'All',
  url: `${siteUrl}${canonicalPath}`,
  sameAs: [
    project.links.website,
    project.links.github,
  ].filter(Boolean),
  author: {
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
  },
  ...(project.links.github ? { codeRepository: project.links.github } : {}),
  ...(project.links.website && project.status !== 'wip' ? { downloadUrl: project.links.website } : {}),
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'EUR',
  },
  isAccessibleForFree: true,
  keywords: project.tags.join(', '),
};
---

<BaseLayout
  title={`${project.name} — KoalaStuff`}
  description={description}
  locale={locale}
  canonicalPath={canonicalPath}
>
  <Header locale={locale} translations={tr} currentPath="/projects" />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdData)} />

  <main id="main-content" class="section" transition:name="main" transition:animate="slide">
    <div class="container">
      <ProjectDetail project={project} locale={locale} translations={tr} />
    </div>
  </main>

  <Footer locale={locale} translations={tr} />
</BaseLayout>
